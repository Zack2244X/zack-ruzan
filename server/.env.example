# Copy this to server/.env on the droplet and fill values (DO NOT commit secrets)

# App
PORT=10000
NODE_ENV=production

# Database (used by Sequelize)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=change_me
DB_NAME=appdb

# MySQL root password (for the MySQL container)
MYSQL_ROOT_PASSWORD=change_me_root

# Auth
JWT_SECRET=replace_with_strong_secret

# CORS / allowed origins (comma-separated)
# Include IP and port for direct access (HTTP) plus your domain when available
ALLOWED_ORIGINS=https://zackpro.codes,http://46.101.209.56,http://46.101.209.56:10000,http://localhost:10000

# New Relic (optional)
NEW_RELIC_LICENSE_KEY=
DB_HOST=YOUR_TIDB_HOST.tidbcloud.com
DB_PORT=4000
DB_USER=YOUR_TIDB_USER
DB_PASSWORD=YOUR_TIDB_PASSWORD
DB_NAME=test
DB_SSL=true
DB_CA=./ca.pem

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
ADMIN_EMAILS=teacher@gmail.com

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
ADMIN_CREATE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

ALLOWED_ORIGINS=https://zackpro.codes,http://46.101.209.56,http://46.101.209.56:10000,http://localhost:10000
NODE_ENV=production
PORT=10000

# New Relic APM Configuration
# Get your license key from: https://one.newrelic.com/admin-portal/api-tokens/licenses
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_LICENSE_KEY_HERE
NEW_RELIC_APP_NAME=Quiz Platform Server
NEW_RELIC_ENABLED=true
NEW_RELIC_LOG_ENABLED=true
