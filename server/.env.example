# Server Setup
PORT=3000
NODE_ENV=development

# Database (used by Sequelize)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=change_me
DB_NAME=appdb
DB_SSL=false

# MySQL root password (for the MySQL container)
MYSQL_ROOT_PASSWORD=change_me_root

# Auth
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=2h
ADMIN_CREATE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
ADMIN_EMAILS=teacher@gmail.com

# CORS / allowed origins (comma-separated)
ALLOWED_ORIGINS=https://example.com,https://app.example.com
INTERNAL_IPS=127.0.0.1,10.0.0.0/8

# Proxy trust hardening (comma-separated)
TRUSTED_PROXY_IPS=127.0.0.1
ALLOWED_INTERNAL_CLIENT_IPS=

# New Relic (optional)
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_LICENSE_KEY_HERE
NEW_RELIC_APP_NAME=Quiz Platform Server
NEW_RELIC_ENABLED=false
NEW_RELIC_LOG_ENABLED=false
