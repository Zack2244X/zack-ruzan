{
  "name": "quiz-platform-server",
  "version": "1.0.0",
  "description": "سيرفر منصة الاختبارات التفاعلية - zack",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node --experimental-loader=newrelic/esm-loader.mjs index.js",
    "dev": "nodemon index.js",
    "test": "jest --forceExit --detectOpenHandles --coverage",
    "test:security": "jest --forceExit --detectOpenHandles rateLimit.auth.test.js frontend.safety.test.js sql.safety.test.js",
    "test:sql-safety": "jest --forceExit --detectOpenHandles __tests__/sql.safety.test.js",
    "lint": "eslint .",
    "pre-deploy": "npm run test:security && npm run test:sql-safety",
    "deploy": "echo 'Deploying...' && ./scripts/local_setup_deploy.sh"
  },
  "dependencies": {
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "express-validator": "7.3.2",
    "google-auth-library": "9.15.1",
    "helmet": "7.2.0",
    "hpp": "0.2.3",
    "ioredis": "5.7.0",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.20.0",
    "newrelic": "13.18.0",
    "node-cache": "5.1.2",
    "rate-limit-redis": "4.2.3",
    "sanitize-html": "2.17.3",
    "sequelize": "6.37.8",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "winston": "3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@express-rate-limit/tsconfig": "^1.0.2",
    "@jest/globals": "30.2.0",
    "eslint": "^9.39.4",
    "jest": "30.3.0",
    "nodemon": "3.1.14",
    "supertest": "7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./__tests__/setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "middleware/**/*.js",
      "models/**/*.js",
      "routes/**/*.js",
      "utils/**/*.js"
    ]
  },
  "overrides": {
    "protobufjs": "7.5.5"
  }
}
