{
  "name": "quiz-platform",
  "version": "1.0.0",
  "description": "Interactive Quiz Platform",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "npm --prefix server install",
    "build:css": "npx tailwindcss -i client/css/tailwind-input.css -o client/css/tailwind.css --minify",
    "watch:css": "npx tailwindcss -i client/css/tailwind-input.css -o client/css/tailwind.css --watch",
    "build": "npm run build:css",
    "start": "node server/index.js",
    "dev": "npm --prefix server run dev",
    "test": "npm --prefix server test",
    "lint": "npm --prefix server run lint",
    "test:client": "vitest run --config client/vitest.config.js --coverage",
    "audit:deps": "npm ls --depth=0 && npm audit --omit=dev",
    "audit:server": "npm --prefix server ls --depth=0 && npm --prefix server audit --omit=dev",
    "deps:unused": "depcheck --ignores=@vitest/coverage-v8",
    "size:assets": "node scripts/asset-size-report.js",
    "test:coverage": "vitest run --coverage",
    "pre-deploy": "npm run test --prefix server || exit 1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "daisyui": "^5.5.19",
    "depcheck": "^1.4.7",
    "esbuild": "^0.27.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "dompurify": "^3.3.3"
  }
}
